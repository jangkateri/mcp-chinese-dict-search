  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Return one exact entry from the main dictionary or an appendix: its Chinese and pinyin aliases, full text, resolved cross-references, related acupuncture-point monographs, and a citation. Accepts a headword; pinyin in tone-numbered (jia3), tone-marked (jiǎ), or toneless (jia) form; simplified or traditional Chinese characters; point identifier; herb name or identifier; formula name or identifier; weights/measures section; or a citation anchor such as a1ALP.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "max_chars": {
          "default": 20000,
          "description": "Truncate the entry text to this many characters. Defaults to 20000; values above 100000 are an error.",
          "type": "integer"
        },
        "source": {
          "default": "all",
          "description": "Restrict the lookup to one part of the book. Defaults to all.",
          "enum": [
            "all",
            "dictionary",
            "meridian",
            "medicinal",
            "formulas",
            "weights"
          ],
          "type": "string"
        },
        "term": {
          "description": "Exact headword; pinyin in tone-numbered (jia3), tone-marked (jiǎ), or toneless (qi) form; simplified or traditional Chinese characters; point identifier such as AA-1; herb or formula name; weights/measures section title; or citation anchor such as a1ALP.",
          "type": "string"
        }
      },
      "required": [
        "term"
      ],
      "type": "object"
    },
    "name": "get_entry",
    "outputSchema": {
      "additionalProperties": false,
