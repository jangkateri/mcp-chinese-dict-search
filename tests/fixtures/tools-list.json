            "properties": {
              "chinese": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "source": {
                "description": "Which part of the source a result comes from.",
                "enum": [
                  "dictionary",
                  "meridian",
                  "medicinal",
                  "formulas",
                  "weights"
                ],
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "term": {
                "type": "string"
              }
