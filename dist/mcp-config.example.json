{
  "mcpServers": {
    "chinese-medicine-dictionary": {
      "command": "C:/path/to/mcp-chinese-dict-search.exe",
      "args": [
        "--data",
        "C:/path/to/dictionary.zip",
        "--pages-dir",
        "C:/mcp-dict-pages"
      ]
    },
    "chinese-medicine-dictionary-semantic": {
      "command": "C:/path/to/mcp-chinese-dict-search.exe",
      "args": [
        "--data",
        "C:/path/to/mcp-dict-data",
        "--pages-dir",
        "C:/mcp-dict-pages",
        "--cache-dir",
        "C:/mcp-dict-semantic",
        "--embedding-model",
        "embeddinggemma:latest",
        "--ollama-url",
        "http://127.0.0.1:11434"
      ]
    }
  }
}
